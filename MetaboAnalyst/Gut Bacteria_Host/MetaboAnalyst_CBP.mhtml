------MultipartBoundary--hmltjsvWaFWbBZeDplph3RzHlb1XtDNyK71XbbX1Iv----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://www.metaboanalyst.ca/resources/css/easyui.min.css

@charset "utf-8";

.panel { overflow: hidden; text-align: left; }

.panel-header, .panel-body { border-width: 1px; border-style: solid; }

.panel-header { padding: 5px; position: relative; }

.panel-header-noborder { border-width: 0px 0px 1px; }

.panel-body { overflow: auto; border-top-width: 0px; }

.panel-body-noheader { border-top-width: 1px; }

.panel-body-noborder { border-width: 0px; }

.panel-with-icon { padding-left: 18px; }

.panel-icon, .panel-tool { position: absolute; top: 50%; margin-top: -8px; =
height: 16px; overflow: hidden; }

.panel-icon { left: 5px; width: 16px; }

.panel-tool { right: 5px; width: auto; }

.panel-tool a { display: inline-block; width: 16px; height: 16px; opacity: =
0.6; margin: 0px 0px 0px 2px; vertical-align: top; }

